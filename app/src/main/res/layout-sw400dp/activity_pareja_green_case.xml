<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".ParejaGreenCase">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="318dp"
        android:layout_height="215dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/descrpcion_imagen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/persona_no_toxica" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="0dp"
        android:layout_height="307dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="224dp"
        android:layout_marginEnd="15dp"
        android:autoSizeTextType="uniform"
        android:text="@string/greencasep"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnparajetoxica10"
        android:layout_width="0dp"
        android:layout_height="73dp"

        android:layout_marginStart="35dp"
        android:layout_marginTop="540dp"
        android:layout_marginEnd="35dp"
        android:autoSizeTextType="uniform"
        android:background="#00FA1E"
        android:letterSpacing="0.2"
        android:lineSpacingExtra="8sp"
        android:onClick="volverAlInicio"
        android:padding="13dp"
        android:text="@string/botonCalificar"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:typeface="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnparajetoxica11"
        android:layout_width="0dp"
        android:layout_marginEnd="35dp"
        android:autoSizeTextType="uniform"
        android:layout_height="73dp"
        android:layout_marginStart="35dp"
        android:padding="13dp"
        android:layout_marginTop="644dp"
        android:background="#00FA1E"
        android:letterSpacing="0.2"
        android:lineSpacingExtra="8sp"
        android:onClick="volverAlInicio"
        android:text="@string/botonVI"

        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:typeface="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</android.support.constraint.ConstraintLayout>